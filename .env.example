# === MultiModelRAG Environment Configuration ===

# Ollama LLM Host (GPU instance IP for AWS deployment)
OLLAMA_HOST=http://localhost:11434

# LLM Model Selection
# For i5 12th gen + 16GB RAM + RTX 2050: use llama3.2:7b-q2
# For better hardware: use llama3.2:7b-q4 or llama3.2
# For fastest: use phi:2.2b-q4
LLM_MODEL=llama3.2:7b-q2

# AWS Region
AWS_REGION=us-east-1

# Frontend URL (for CORS)
CORS_ORIGINS=http://localhost:3000

# Next.js public env
NEXT_PUBLIC_API_URL=http://localhost:8000

# Redis Configuration (optional - for distributed caching)
# If Redis is not available, the system falls back to in-memory caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=2

# API Configuration
API_TIMEOUT=30
MAX_RETRIES=0
DISABLE_RETRY_LOOP=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
