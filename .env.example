# === MultiModelRAG Environment Configuration ===

# Ollama LLM Host (GPU instance IP for AWS deployment)
OLLAMA_HOST=http://localhost:11434

# Local LLM (must be pulled on the HOST ollama: `ollama pull <name>`)
# Pick a model that fits your GPU's VRAM at Q4, or it spills to CPU and gets slow.
#   4GB VRAM (e.g. RTX 2050): qwen2.5:3b (~1.9GB) or qwen3:4b (~2.6GB)
#   8GB+ VRAM:                qwen2.5:7b (~4.7GB) or llama3.1:8b
LLM_MODEL=qwen2.5:3b

# Anthropic (Claude) API Key — required to use the "Claude" model option
# Get one at https://console.anthropic.com/settings/keys (starts with sk-ant-)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key — required to use the "API Gemini" model option
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Region
AWS_REGION=us-east-1

# Frontend URL (for CORS)
CORS_ORIGINS=http://localhost:3000

# Next.js public env
NEXT_PUBLIC_API_URL=http://localhost:8000

# Redis Configuration (optional - for distributed caching)
# If Redis is not available, the system falls back to in-memory caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=2

# API Configuration
API_TIMEOUT=30
MAX_RETRIES=0
DISABLE_RETRY_LOOP=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
